# Samurai Bot - Russian Localization
# Fluent format: https://projectfluent.org/
#
# For random responses, use '---' as delimiter between options.
# Each option can span multiple lines.

# ========== ERRORS ==========
error-no-reply = Эта команда должна быть ответом на какое-либо сообщение!
error-report-admin = Админов репортишь? Ай-ай-ай 😈
error-report-self = Нельзя репортить самого себя 🤪
error-restrict-admin = Невозможно ограничить администратора.
error-wrong-time-format = Неправильный формат времени. Используйте число + символ h, m или d. Например, 4h
error-message-too-short = Пожалуйста, избегайте бессмысленных коротких приветствий. Если у Вас есть вопрос или информация, напишите всё в одном сообщении. Заранее спасибо! 🤓
error-ban-admin = 😡 Bruh. Админа нельзя забанить :/
error-checkperms-admin = ✅ У админов нет никаких ограничений.
error-givemedia-admin = Админам итак разрешено отправлять медиа!
error-givestickers-admin = Админам итак разрешено отправлять стикеры!

# ========== REPORT ==========
report-date-format = %d.%m.%Y в %H:%M (время сервера)
report-message = 🕗 Отправлено { $date }
report-from = 
    
    👤 Репорт от: { $reporter }
report-note = 
    
    💬 Примечание: { $note }

# ========== ACTION BUTTONS ==========
action-go-to-message = 👀 Перейти к сообщению
action-del-msg = 🗑 Удалить сообщение
action-del-and-ban = 🗑 Удалить + ❌ бан навсегда
action-del-and-readonly = 🗑 Удалить + 🙊 мут на день
action-del-and-readonly2 = 🗑 Удалить + 🙊 мут на неделю
action-false-alarm = ❎ Нарушений нет
action-false-alarm-2 = ❎ Нарушений нет (🙊 мут репортера на день)
action-false-alarm-3 = ❎ Нарушений нет (🙊 мут репортера на неделю)
action-false-alarm-4 = ❎ Нарушений нет (❌ бан репортера)

# ========== ACTION RESULTS ==========
action-deleted = 

    🗑 <b>Удалено</b>
action-deleted-banned = 

    🗑❌ <b>Удалено, юзер забанен</b>
action-deleted-readonly = 

    🗑🙊 <b>Удалено, + выдан мут на день.</b>
action-deleted-readonly2 = 

    🗑🙊 <b>Удалено, + выдан мут на неделю.</b>
action-dismissed = 

    ❎ <b>Нарушений не обнаружено.</b>
action-deleted-dismissed2 = 

    ❎ <b>Нарушений не обнаружено (🙊 репортеру выдан мут на 1 день).</b>
action-deleted-dismissed3 = 

    ❎ <b>Нарушений не обнаружено (🙊 репортеру выдан мут на 7 дней).</b>
action-deleted-dismissed4 = 

    ❎ <b>Нарушений не обнаружено (❌ репортер забанен).</b>

# ========== RESTRICTIONS ==========
resolved-readonly = <i>Выдан мут на ({ $time })</i>
resolved-nomedia = <i>Запрещено отправлять медиа на ({ $time })</i>
resolved-nomedia-forever = <i>Запрещено отправлять медиа навсегда.</i>
resolved-givemedia = <i>Разрешено отправлять медиа на ({ $time })</i>
resolved-givemedia-forever = <i>Разрешено отправлять медиа навсегда.</i>
resolved-givestickers = <i>Разрешено отправлять стикеры на ({ $time })</i>
resolved-givestickers-forever = <i>Разрешено отправлять стикеры навсегда.</i>
resolved-revokestickers = <i>Запрещено отправлять стикеры на ({ $time })</i>
resolved-revokestickers-forever = <i>Запрещено отправлять стикеры навсегда.</i>
restriction-forever = <i>Выдан мут навсегда.</i>
user-unmuted = <i>Мут снят.</i>

# ========== BAN ==========
resolved-ban = <i>Участник заблокирован.</i>
resolved-unban = <i>Участник разблокирован.</i>

# ========== MODES ==========
enabled-ro = <i>Режим «только-чтение» включен.</i>
disabled-ro = <i>Режим «только-чтение» отключен.</i>

# ========== ADMINS ==========
need-admins-attention = Товарищи админы, в чате нужно ваше присутствие!
    
    <a href="https://t.me/c/{ $chat_id }/{ $msg_id }">Перейти к сообщению</a>

# ========== RULES ==========
rules-message = <b>Правила чата:</b>

    📈 В чате действует <u>система репутации</u>
    ⛔️ Новичкам запрещено отправлять медиа
    🤬 Мат и оскорбления запрещены и <u>удаляются автоматически</u> нашим ботом
    👹 Оффтоп/спам/троллинг наказывается 🍌 бананами

    <b>Всем мира 🤞</b>

# ========== PROFANITY ==========
profanity-user-kicked = Ваше имя в Telegram содержит ненормативную лексику.
    По этой причине вы были кикнуты из чата.
    
    Пожалуйста, отредактируйте отображаемое имя и попробуйте заново.
    Нарушение найдено в слове: <u>{ $word }</u>

# ========== THROTTLING ==========
throttle-warning = ⚠️ Слишком много сообщений. Подождите немного.

